# Root .env consumed by docker-compose.dev.yml (local dev stack).
# Copy to .env (gitignored) and fill in owned local values:
#     cp .env.example .env
# Also copy backend-service/.env.example to backend-service/.env — the
# dev-local script requires both files.

# ---- Required ----
POSTGRES_PASSWORD=lexilingo_pass
# openssl rand -hex 32
SECRET_KEY=
# Comma-separated origins allowed by the backend API (Flutter web dev servers).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---- Optional ----
POSTGRES_USER=lexilingo
POSTGRES_DB=lexilingo
DEBUG=False
CORS_ALLOW_ORIGIN_REGEX=

# Firebase is opt-in and web-only (FIREBASE_ENABLED). Leave empty to run the
# local stack without Google sign-in; backend starts fine without it.
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_CLIENT_ID=

# ---- up-full profile (backend + ai-service) ----
AI_ADMIN_API_KEY=
GEMINI_API_KEY=

# ---- tools profile (pgadmin, mongo-express) ----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=
