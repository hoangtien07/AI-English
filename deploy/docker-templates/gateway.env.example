# Variables consumed by render-nginx.sh to produce nginx/conf.d/*.conf.
# Copy to gateway.env (gitignored) and fill in real values.

# Public hostnames served by the edge nginx.
API_SERVER_NAME=api.example.com
AI_SERVER_NAME=ai.example.com

# Certbot-managed certificate paths inside the nginx container
# (/etc/letsencrypt is mounted from ./certbot/conf).
API_SSL_CERT_PATH=/etc/letsencrypt/live/api.example.com/fullchain.pem
API_SSL_KEY_PATH=/etc/letsencrypt/live/api.example.com/privkey.pem
AI_SSL_CERT_PATH=/etc/letsencrypt/live/ai.example.com/fullchain.pem
AI_SSL_KEY_PATH=/etc/letsencrypt/live/ai.example.com/privkey.pem

# Upstream addresses (private IP or resolvable hostname, no scheme/port).
BACKEND_UPSTREAM_ADDR=10.0.0.2
AI_UPSTREAM_ADDR=10.0.0.3
