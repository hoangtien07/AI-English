# Variables consumed by render-hybrid.sh to produce kong.hybrid.yml.
# Copy to kong-hybrid.env (gitignored) and fill in real values.

# Browser origins allowed by the CORS plugin (full scheme + host, no path).
PUBLIC_WEB_ORIGIN=https://app.example.com
ADMIN_WEB_ORIGIN=https://admin.example.com

# Upstream base URLs Kong proxies to (scheme + host, no path).
BACKEND_UPSTREAM_URL=https://your-backend.example.com
AI_UPSTREAM_URL=https://your-ai-service.example.com

# key-auth credentials handed to each client class. Generate independent
# high-entropy values per consumer; never reuse the local dev keys.
KONG_MOBILE_API_KEY=
KONG_ADMIN_API_KEY=
KONG_INTERNAL_API_KEY=
