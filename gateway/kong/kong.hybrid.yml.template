_format_version: "3.0"
_transform: true

# Hybrid deployment profile -- TEMPLATE.
# Kong's declarative loader reads this file verbatim and does NOT expand
# environment variables, so never mount this template directly. Render it
# first:
#     ./render-hybrid.sh
# which substitutes every ${VAR} below from the environment (optionally
# sourced from kong-hybrid.env) and writes kong.hybrid.yml, the file the
# compose service actually mounts.
# Upstream base URLs come from BACKEND_UPSTREAM_URL / AI_UPSTREAM_URL.

consumers:
  - username: mobile-app
    custom_id: mobile-app
    acls:
      - group: mobile-app
    keyauth_credentials:
      - key: ${KONG_MOBILE_API_KEY}

  - username: admin-web
    custom_id: admin-web
    acls:
      - group: admin-web
    keyauth_credentials:
      - key: ${KONG_ADMIN_API_KEY}

  - username: internal-backend
    custom_id: internal-backend
    acls:
      - group: internal
    keyauth_credentials:
      - key: ${KONG_INTERNAL_API_KEY}

plugins:
  - name: cors
    config:
      origins:
        - ${PUBLIC_WEB_ORIGIN}
        - ${ADMIN_WEB_ORIGIN}
      methods:
        - GET
        - POST
        - PUT
        - PATCH
        - DELETE
        - OPTIONS
      headers:
        - Authorization
        - Content-Type
        - X-Api-Key
        - X-Request-Id
        - X-Idempotency-Key
        - X-Admin-Key
        - X-AI-Service-Secret
      exposed_headers:
        - X-Request-Id
        - X-RateLimit-Remaining-Minute
        - X-RateLimit-Remaining-Day
      credentials: true
      max_age: 3600

  - name: correlation-id
    config:
      header_name: X-Request-Id
      generator: uuid
      echo_downstream: true

  - name: prometheus

  - name: opentelemetry
    config:
      endpoint: http://otel-collector:4318/v1/traces
      resource_attributes:
        service.name: lexilingo-kong-gateway
        service.namespace: lexilingo
        deployment.environment: hybrid

  - name: request-size-limiting
    config:
      allowed_payload_size: 12
      size_unit: megabytes
      require_content_length: false

services:
  - name: backend-service
    url: ${BACKEND_UPSTREAM_URL}
    routes:
      - name: backend-health
        paths:
          - /backend-health
        methods:
          - GET
        strip_path: true
        plugins:
          - name: request-transformer
            config:
              replace:
                uri: /health

      - name: backend-admin
        paths:
          - /api/v1/admin
        methods:
          - GET
          - POST
          - PUT
          - PATCH
          - DELETE
          - OPTIONS
        strip_path: false
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-Api-Key
              hide_credentials: true
              run_on_preflight: false
          - name: acl
            config:
              allow:
                - admin-web
          - name: rate-limiting
            config:
              policy: local
              minute: 60
              hour: 1000
              day: 5000
              limit_by: consumer
              hide_client_headers: false

      - name: backend-api-catchall
        paths:
          - /api/v1
        methods:
          - GET
          - POST
          - PUT
          - PATCH
          - DELETE
          - OPTIONS
        strip_path: false
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-Api-Key
              hide_credentials: true
              run_on_preflight: false
          - name: acl
            config:
              allow:
                - mobile-app
                - admin-web
                - internal
          - name: rate-limiting
            config:
              policy: local
              minute: 180
              hour: 5000
              day: 30000
              limit_by: consumer
              hide_client_headers: false

  - name: ai-service
    url: ${AI_UPSTREAM_URL}
    routes:
      - name: ai-health
        paths:
          - /ai-health
        methods:
          - GET
        strip_path: true
        plugins:
          - name: request-transformer
            config:
              replace:
                uri: /health

      - name: ai-stt
        paths:
          - /api/v1/stt
        methods:
          - POST
          - OPTIONS
        strip_path: false
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-Api-Key
              hide_credentials: true
              run_on_preflight: false
          - name: acl
            config:
              allow:
                - mobile-app
                - admin-web
          - name: rate-limiting
            config:
              policy: local
              minute: 30
              hour: 400
              day: 2000
              limit_by: consumer
              hide_client_headers: false

      - name: ai-tts
        paths:
          - /api/v1/tts
        methods:
          - POST
          - OPTIONS
        strip_path: false
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-Api-Key
              hide_credentials: true
              run_on_preflight: false
          - name: acl
            config:
              allow:
                - mobile-app
                - admin-web
          - name: rate-limiting
            config:
              policy: local
              minute: 40
              hour: 500
              day: 3000
              limit_by: consumer
              hide_client_headers: false

      - name: ai-chat
        paths:
          - /api/v1/chat
          - /api/v1/lexi
          - /api/v1/topics
        methods:
          - GET
          - POST
          - OPTIONS
        strip_path: false
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-Api-Key
              hide_credentials: true
              run_on_preflight: false
          - name: acl
            config:
              allow:
                - mobile-app
                - admin-web
                - internal
          - name: rate-limiting
            config:
              policy: local
              minute: 80
              hour: 1500
              day: 9000
              limit_by: consumer
              hide_client_headers: false

      - name: ai-analytics
        paths:
          - /api/v1/ai
        methods:
          - GET
          - POST
          - OPTIONS
        strip_path: false
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-Api-Key
              hide_credentials: true
              run_on_preflight: false
          - name: acl
            config:
              allow:
                - admin-web
                - internal
          - name: rate-limiting
            config:
              policy: local
              minute: 50
              hour: 1000
              day: 6000
              limit_by: consumer
              hide_client_headers: false

      - name: ai-admin
        paths:
          - /api/v1/ai-admin
        methods:
          - GET
          - POST
          - PUT
          - PATCH
          - DELETE
          - OPTIONS
        strip_path: true
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-Api-Key
              hide_credentials: true
              run_on_preflight: false
          - name: acl
            config:
              allow:
                - admin-web
                - internal
          - name: rate-limiting
            config:
              policy: local
              minute: 30
              hour: 500
              day: 3000
              limit_by: consumer
              hide_client_headers: false
          - name: request-transformer
            config:
              replace:
                uri: /api/v1/admin
