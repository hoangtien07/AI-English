# Copy this to gateway/.env before running docker compose

# Grafana admin login (required by docker-compose.kong*.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Kong declarative configs cannot read env vars, so these are NOT needed for the
# local profile -- kong.yml already carries committed local-dev-* credentials.
# They are only consumed by kong/render-hybrid.sh for the hybrid profile; that
# script sources kong/kong-hybrid.env by default (see kong-hybrid.env.example),
# or you may export the same names here and pass the file explicitly:
#   ./kong/render-hybrid.sh ../.env
KONG_MOBILE_API_KEY=
KONG_ADMIN_API_KEY=
KONG_INTERNAL_API_KEY=
