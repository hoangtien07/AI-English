# ============================================================
# .env.local — Template. Copy thành .env.local rồi điền key.
# File này AN TOÀN để commit (không có key thật).
# ============================================================

# ── Backend / AI service ──────────────────────────────────
# URL không có dấu / cuối.
API_BASE_URL=http://127.0.0.1:8000/api/v1
AI_SERVICE_URL=http://127.0.0.1:8001/api/v1
VOICE_DUPLEX_ENABLED=false

# ── Google Sign-In (public client config) ─────────────────
GOOGLE_SERVER_CLIENT_ID=your-firebase-web-client-id.apps.googleusercontent.com

# ── Firebase Web SDK (lấy tại Firebase Console → Project Settings → Your apps → Web) ──
# Đây là public client config, KHÔNG phải server secret.
# Vẫn không được hardcode trong source vì GitHub Secret Scanning sẽ alert.
FIREBASE_API_KEY=PASTE_NEW_API_KEY_HERE
FIREBASE_AUTH_DOMAIN=english-5d522.firebaseapp.com
FIREBASE_PROJECT_ID=english-5d522
FIREBASE_STORAGE_BUCKET=english-5d522.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=403021618812
FIREBASE_APP_ID=1:403021618812:web:PASTE_NEW_APP_ID_HERE
FIREBASE_MEASUREMENT_ID=G-QQ057LF052

# ── Gemini / AI provider keys → KHÔNG để ở đây ───────────
# Chỉ để trong backend-service/.env hoặc ai-service/.env
